# Leave empty to use embedded PostgreSQL (PGlite) for local development.
DATABASE_URL=
APP_URL=http://127.0.0.1:3000
DATA_DIR=.data
# Optional private cloud storage; required on Vercel. Never use NEXT_PUBLIC_ for this key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=notesphere
# Production requires PostgreSQL, persistent file storage and SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NoteSphere <noreply@example.com>
