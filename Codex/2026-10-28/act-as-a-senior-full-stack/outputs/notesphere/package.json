{
  "name": "notesphere",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "test:flows": "tsx scripts/test-flows.ts",
    "postinstall": "node scripts/assets.mjs",
    "db:admin": "node --env-file-if-exists=.env.local --import tsx scripts/make-admin.ts",
    "local": "node scripts/start-local.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/postcss": "4.1.18",
    "fflate": "0.8.3",
    "file-type": "21.3.4",
    "lucide-react": "0.562.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "pdfjs-dist": "5.4.449",
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.1.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "prettier": "3.9.10",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
